# ─────────────────────────────────────────────────────────────────────
# Explicit exclusions — keep manuscript / internal-only material out of
# the public repo even if someone ever copies these directories in.
# ─────────────────────────────────────────────────────────────────────
paper/
# docs/ is internal-only EXCEPT for docs/assets (public README screenshots).
# Use docs/* (not docs/) so the whitelist below can re-include a subdirectory.
docs/*
!docs/assets/
HANDOFF.md
AGENTS.md
CLAUDE.md
.claude/
.openclaw/
.hermes/
data/processed/
.playwright-mcp/

# ─────────────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.installed.cfg
build/
dist/
wheels/
sdist/
develop-eggs/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# Virtual envs
.venv/
venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

